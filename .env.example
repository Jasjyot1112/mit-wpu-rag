# =============================================================
# MIT-WPU RAG Engine - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Application ---
APP_NAME=MIT-WPU RAG Engine
DEBUG=false
HOST=127.0.0.1
PORT=8000

# --- API Authentication ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=

# --- Database ---
DATABASE_URL=sqlite:///./rag.db

# --- File Storage ---
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=100
MAX_PDF_PAGES=500

# --- Google Gemini ---
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-004
EMBEDDING_DIMENSION=768
GEMINI_BATCH_SIZE=10
GEMINI_MAX_RETRIES=3

# --- Pinecone ---
# Get your key at: https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mit-wpu-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=mit-wpu

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
DENSE_TOP_K=20
BM25_TOP_K=20
FUSION_TOP_K=30
FINAL_CONTEXT_TOP_K=6
SIMILARITY_THRESHOLD=0.3
RRF_K=60

# --- OCR (Tesseract) ---
# Windows default install path:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGE=eng
OCR_DPI=250

# --- Reranking ---
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Institution ---
INSTITUTION_ID=MIT-WPU

# --- Workers ---
MAX_WORKER_CONCURRENCY=2
JOB_RETRY_LIMIT=3

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
